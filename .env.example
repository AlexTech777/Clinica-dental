APP_NAME=Sonrisa Clara
APP_ENV=development
DATABASE_URL=sqlite:///./dental.db
TIMEZONE=America/Santiago
DRY_RUN=true
SEED_DEMO=true
# Generate a random value before using production: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# Google Calendar: compartir el calendario con el correo de la cuenta de servicio y rol "Hacer cambios en eventos".
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=

# Twilio WhatsApp Sandbox: conectar al Sandbox y configurar /webhooks/whatsapp como webhook entrante.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=
ASSISTANT_WHATSAPP=
MESSAGE_START_HOUR=9
MESSAGE_END_HOUR=20
